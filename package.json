{
  "name": "velokey",
  "version": "1.0.0",
  "type": "module",
  "author": {
    "name": "Rishabh",
    "email": "rishabh.j.tripathi@gmail.com"
  },
  "license": "Apache-2.0",
  "private": false,
  "scripts": {
    "dev": "next dev --webpack",
    "analyze": "ANALYZE=true npm run build",
    "realtime:dev": "partykit dev",
    "realtime:deploy": "partykit deploy",
    "build": "next build --webpack",
    "start": "next start",
    "scan:sonar": "eslint --config eslint.sonar.config.mjs .",
    "verify": "npm run typecheck && npm run lint && npm run scan:sonar && npm run check:unused && npm run test",
    "verify:full": "npm run verify && npm run build && npm run test:e2e",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:unused": "knip",
    "audit:lighthouse": "lighthouse http://127.0.0.1:3000 --output=html --output-path=./lighthouse-report.html",
    "prepare": "husky",
    "postinstall": "node -e \"const fs=require('fs');const raw=fs.readFileSync('./node_modules/inspirational-quotes/data/data.json','utf8');fs.mkdirSync('./data',{recursive:true});fs.writeFileSync('./data/quotes.json',JSON.stringify(JSON.parse(raw.replace(/^\\uFEFF/,''))));\" && node scripts/repair-quotes.cjs && node scripts/attribute-quotes.cjs && node scripts/generate-code-data.mjs && node scripts/sync-theme-fonts.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,json,md}": "prettier --write"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@next/third-parties": "^16.2.3",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@serwist/next": "^9.5.7",
    "@tabler/icons-react": "^3.41.1",
    "@types/canvas-confetti": "^1.9.0",
    "@vercel/analytics": "^2.0.1",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "inspirational-quotes": "^2.0.1",
    "lucide-react": "^1.8.0",
    "motion": "^12.42.2",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "partykit": "^0.0.115",
    "partysocket": "^1.3.0",
    "qrcode-generator": "^2.0.4",
    "radix-ui": "^1.4.3",
    "random-words": "^2.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "3.8.0",
    "serwist": "^9.5.7",
    "shadcn": "^4.2.0",
    "shiki": "^4.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "web-haptics": "^0.0.6"
  },
  "overrides": {
    "browserslist": "^4.29.0",
    "dompurify": "^3.4.15",
    "sharp": "^0.35.4",
    "undici": "^7.29.1",
    "partykit": {
      "esbuild": "$esbuild",
      "miniflare": "$miniflare"
    }
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.10",
    "@next/eslint-plugin-next": "16.1.7",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.5.2",
    "@storybook/addon-vitest": "^10.5.2",
    "@storybook/nextjs-vite": "^10.5.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "browserslist": "^4.29.0",
    "dompurify": "^3.4.15",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.1.7",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "^4.2.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.27.0",
    "lighthouse": "^13.4.0",
    "lint-staged": "^17.1.0",
    "miniflare": "^4.20250917.0",
    "postcss": "^8",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "storybook": "^10.5.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.11"
  }
}
